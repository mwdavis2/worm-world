# Copy this file to .env and fill in the values you need.
# See the README's "Getting started" and "Testing task sync" sections.

# Required. Printed out on the first `npm run tauri dev` run.
DATABASE_URL="sqlite:///<ABSOLUTE PATH TO DB>"

# Optional - only needed to test Google Tasks sync. Create an OAuth 2.0
# Client ID of type "Desktop app" in the Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
